{
  "gateway": {
    "mode": "local",
    "port": 0,
    "bind": "lan",
    "auth": { "token": "agenthub-worker-token" },
    "remote": { "token": "agenthub-worker-token" },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true,
      "allowInsecureAuth": true,
      "allowedOrigins": ["*"]
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "http://localhost:6167",
      "userId": "@worker:agenthub.local",
      "accessToken": "",
      "encryption": false,
      "network": { "dangerouslyAllowPrivateNetwork": true },
      "autoJoin": "always",
      "dm": {
        "policy": "allowlist",
        "allowFrom": ["@admin:agenthub.local", "@manager:agenthub.local"]
      },
      "groupPolicy": "allowlist",
      "groupAllowFrom": ["@admin:agenthub.local", "@manager:agenthub.local"],
      "groups": {
        "*": { "allow": true, "requireMention": true }
      },
      "streaming": "partial",
      "blockStreaming": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "agenthub-llm": {
        "baseUrl": "http://localhost:8000/v1",
        "apiKey": "agenthub-internal",
        "api": "openai-completions",
        "models": [
          {
            "id": "default",
            "reasoning": false,
            "contextWindow": 128000,
            "maxTokens": 8192,
            "input": ["text"]
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 600,
      "workspace": "~",
      "model": { "primary": "agenthub-llm/default" },
      "maxConcurrent": 4,
      "subagents": { "maxConcurrent": 8 },
      "elevatedDefault": "full"
    }
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "elevated": {
      "enabled": true,
      "allowFrom": { "matrix": ["*"] }
    }
  },
  "plugins": {
    "load": { "paths": [] },
    "entries": {}
  }
}
