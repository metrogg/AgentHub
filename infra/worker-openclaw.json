{
  "gateway": {
    "mode": "local",
    "port": 18800,
    "bind": "lan",
    "auth": {
      "token": "agenthub-worker-token"
    },
    "remote": {
      "token": "agenthub-worker-token"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true,
      "allowInsecureAuth": true,
      "allowedOrigins": [
        "*"
      ]
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "http://localhost:6167",
      "userId": "@worker:agenthub.local",
      "accessToken": "rQyEyzxBS50XBZv4fidtvV0snkMNxMa9",
      "encryption": false,
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "autoJoin": "always",
      "dm": {
        "policy": "allowlist",
        "allowFrom": [
          "@admin:agenthub.local",
          "@manager:agenthub.local"
        ]
      },
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "@admin:agenthub.local",
        "@manager:agenthub.local"
      ],
      "groups": {
        "*": {
          "requireMention": true
        }
      },
      "streaming": "partial",
      "blockStreaming": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "agenthub-llm": {
        "baseUrl": "http://localhost:8000/v1",
        "apiKey": "agenthub-internal",
        "api": "openai-completions",
        "models": [
          {
            "id": "default",
            "reasoning": false,
            "contextWindow": 128000,
            "maxTokens": 8192,
            "input": [
              "text"
            ],
            "name": "default"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 600,
      "workspace": "/mnt/f/Learning/AgentHub/infra",
      "model": {
        "primary": "agenthub-llm/default"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "elevatedDefault": "full"
    }
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "matrix": [
          "*"
        ]
      }
    }
  },
  "plugins": {
    "load": {
      "paths": []
    },
    "entries": {}
  }
}