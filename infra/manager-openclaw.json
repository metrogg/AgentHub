{
  "gateway": {
    "mode": "local",
    "port": 18799,
    "bind": "lan",
    "auth": {
      "token": "agenthub-manager-token"
    },
    "remote": {
      "token": "agenthub-manager-token"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true,
      "allowInsecureAuth": true,
      "allowedOrigins": [
        "*"
      ]
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "http://localhost:6167",
      "userId": "@manager:agenthub.local",
      "accessToken": "3WvEyFiLtvFy7DTINMdPggTDc0S1oL9I",
      "encryption": false,
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "autoJoin": "always",
      "dm": {
        "policy": "allowlist",
        "allowFrom": [
          "@admin:agenthub.local"
        ]
      },
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "@admin:agenthub.local"
      ],
      "groups": {
        "*": {
          "requireMention": true
        }
      },
      "streaming": "partial",
      "blockStreaming": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "agenthub-llm": {
        "baseUrl": "http://localhost:8000/v1",
        "apiKey": "agenthub-internal",
        "api": "openai-completions",
        "models": [
          {
            "id": "default",
            "reasoning": false,
            "contextWindow": 128000,
            "maxTokens": 8192,
            "input": [
              "text"
            ],
            "name": "default"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 1800,
      "workspace": "~",
      "model": {
        "primary": "agenthub-llm/default"
      },
      "maxConcurrent": 8,
      "subagents": {
        "maxConcurrent": 16
      },
      "elevatedDefault": "full",
      "heartbeat": {
        "every": "1h",
        "prompt": "Read ~/HEARTBEAT.md and follow the checklist."
      }
    }
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "matrix": [
          "*"
        ]
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "resetByType": {
      "dm": {
        "mode": "daily",
        "atHour": 4
      },
      "group": {
        "mode": "daily",
        "atHour": 4
      }
    }
  },
  "plugins": {
    "load": {
      "paths": []
    },
    "entries": {}
  },
  "commands": {
    "restart": true
  }
}