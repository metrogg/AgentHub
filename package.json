{
  "name": "agenthub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "dev:web": "bun --filter @agenthub/web dev",
    "dev:server": "bun run db:migrate && NODE_NO_WARNINGS=1 bun --watch apps/server/src/index.ts",
    "dev:desktop": "bun --filter @agenthub/desktop tauri:dev",
    "infra:up": "docker compose -f infra/docker-compose.hiclaw-lite.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.hiclaw-lite.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.hiclaw-lite.yml logs -f",
    "matrix:up": "docker compose -f infra/docker-compose.hiclaw-lite.yml up -d tuwunel",
    "matrix:down": "docker compose -f infra/docker-compose.hiclaw-lite.yml stop tuwunel",
    "matrix:logs": "docker compose -f infra/docker-compose.hiclaw-lite.yml logs -f tuwunel",
    "build": "bun run --filter '*' build",
    "build:desktop": "bun --filter @agenthub/desktop tauri:build",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "db:generate": "bun --filter @agenthub/db generate",
    "db:migrate": "bun --filter @agenthub/db migrate",
    "db:studio": "bun --filter @agenthub/db studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "drizzle-orm": "0.36.0"
  }
}
