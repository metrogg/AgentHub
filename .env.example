# AgentHub environment template
# Copy this file to .env and fill only the values you need.

# General
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Storage
DATABASE_URL=./storage/agenthub.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Web
VITE_API_URL=http://localhost:8000/api
VITE_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=ws://localhost:8000

# Runtime LLM provider. The server reads these explicitly and does not depend on
# ~/.codex/auth.json, codex login, or any host CLI login state.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# OpenAI-compatible defaults
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Anthropic defaults
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional provider keys for OpenAI-compatible gateways
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# Local CLI support is a development convenience for host-installed CLIs.
ENABLE_LOCAL_CLI_PROBES=true
ENABLE_CODEX_CHATGPT_AUTH=true
SYNC_CODEX_CLI_AUTH=true
AGENTHUB_ENABLE_CODE_AGENT_EXECUTION=false
AGENTHUB_CODE_AGENT_TIMEOUT_MS=600000
AGENTHUB_ENABLE_DYNAMIC_QUICK_PROMPTS=true

# Execution sandbox
# local-workdir: host process + isolated workdir/temp/cache/config env
# docker: run the Code Agent CLI in a Docker container; requires an image with the CLI installed
AGENTHUB_SANDBOX_PROVIDER=local-workdir
AGENTHUB_DOCKER_SANDBOX_IMAGE=
AGENTHUB_DOCKER_NETWORK_POLICY=default
AGENTHUB_DOCKER_NETWORK=bridge
AGENTHUB_DOCKER_READONLY_ROOTFS=false
AGENTHUB_DOCKER_USER=
AGENTHUB_DOCKER_EXTRA_ARGS=

# Optional deployment providers
VERCEL_TOKEN=
NETLIFY_TOKEN=
