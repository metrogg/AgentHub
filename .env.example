# ============================================
# AgentHub 环境变量模板
# 复制为 .env 后修改实际值
# ============================================

# ----- 通用 -----
NODE_ENV=development

# ----- Server (apps/server) -----
PORT=8000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ----- 数据库 (SQLite via Bun) -----
DATABASE_URL=./storage/agenthub.db

# ----- 鉴权 -----
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ----- 前端 (apps/web) -----
VITE_API_URL=http://localhost:8000/api

# ----- LLM Providers (按需填写) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
GEMINI_API_KEY=

# ----- 部署平台 (可选) -----
VERCEL_TOKEN=
NETLIFY_TOKEN=
