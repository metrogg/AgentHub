{
  "name": "@agenthub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "build:exe": "bun build --compile --target=bun --windows-hide-console --windows-title=AgentHub --windows-description=\"AgentHub local server\" --outfile dist/agenthub-server.exe src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agenthub/db": "workspace:*",
    "@agenthub/shared": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.78",
    "@hono/zod-validator": "^0.4.1",
    "@mastra/core": "^1.35.0",
    "ai": "^6.0.185",
    "hono": "^4.6.3",
    "adm-zip": "^0.5.17",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  }
}
