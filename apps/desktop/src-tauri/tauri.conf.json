{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "0.1.0",
  "identifier": "com.agenthub.desktop",
  "build": {
    "beforeDevCommand": "bun --filter @agenthub/desktop prepare:sidecar --skip-web-build && bun --filter @agenthub/web dev --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun --filter @agenthub/desktop prepare:sidecar",
    "frontendDist": "resources/web-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/web-dist",
      "resources/binaries/agenthub-server.exe"
    ]
  }
}
