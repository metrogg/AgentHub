{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "0.1.0",
  "identifier": "com.agenthub.desktop",
  "build": {
    "beforeDevCommand": "bun --filter @agenthub/desktop dev:services",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun --filter @agenthub/desktop prepare:sidecar",
    "frontendDist": "resources/web-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "installer-assets/agenthub-installer.ico",
        "uninstallerIcon": "installer-assets/agenthub-installer.ico",
        "headerImage": "installer-assets/nsis-header.bmp",
        "sidebarImage": "installer-assets/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer-assets/nsis-header.bmp",
        "installMode": "currentUser"
      }
    },
    "resources": [
      "resources/web-dist",
      "resources/binaries/agenthub-server.exe"
    ]
  }
}
