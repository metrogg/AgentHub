# 前端构建 Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

# 复制依赖文件并安装
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# 复制源码并构建
COPY frontend/ .
RUN npm run build

# 生产环境使用 Nginx 托管静态文件
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
